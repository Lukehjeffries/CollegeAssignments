\f0\fs24 \cf0 library IEEE;\
use IEEE.STD_LOGIC_1164.ALL;\
\
entity ALU4 is\
    port(a, b        : in  std_logic_vector(3 downto 0);\
         ALUOp       : in  std_logic_vector(1 downto 0);\
         bInvert     : in  std_logic;\
         result      : out std_logic_vector(3 downto 0);\
         CarryOut    : out std_logic;\
         overflow    : out std_logic;\
         less        : out std_logic;\
         zero        : out std_logic);\
end ALU4;\
\
architecture Structural of ALU4 is\
    component ALU1 is\
        port(a, b, CarryIn, bInvert : in  std_logic;\
             ALUOp                 : in  std_logic_vector(1 downto 0);\
             result, CarryOut       : out std_logic);\
    end component;\
    \
    signal carries      : std_logic_vector(4 downto 0);\
    signal results      : std_logic_vector(3 downto 0);\
    signal ovf          : std_logic;\
    signal or_reduction : std_logic;\
begin\
    -- Connect the carry chain\
    carries(0) <= bInvert;  -- First carry in is bInvert for subtraction\
    \
    -- Generate four 1-bit ALUs\
    alugen: for i in 0 to 3 generate\
        alu: ALU1 port map(\
            a => a(i),\
            b => b(i),\
            CarryIn => carries(i),\
            bInvert => bInvert,\
            ALUOp => ALUOp,\
            result => results(i),\
            CarryOut => carries(i+1)\
        );\
    end generate alugen;\
    \
    -- Connect outputs\
    result <= results;\
    CarryOut <= carries(4);\
    \
    -- Overflow detection (MSB carry in xor carry out)\
    ovf <= carries(3) xor carries(4);\
    overflow <= ovf;\
    \
    -- Less than output (MSB result xor overflow)\
    less <= results(3) xor ovf;\
    \
    -- Zero flag (NOR of all result bits)\
    or_reduction <= results(0) or results(1) or results(2) or results(3);\
    zero <= not or_reduction;\
end Structural;}